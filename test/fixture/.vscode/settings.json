{
	"generalLsp.servers": {
		"gopls": {
			"command": ["gopls"],
			"languages": ["go"],
			"rootMarkers": ["go.mod"],
			"settings": { "gopls.hoverKind": "NoDocumentation" }
		},
		"clangd": {
			"command": ["clangd"],
			"filePatterns": ["*.c"]
		},
		"clangd-loose": {
			"command": ["clangd"],
			"filePatterns": ["*.cc"],
			"rootMarkers": ["compile_commands.json"],
			"fallbackRoot": "~/.cache/general-lsp-test/scratch",
			"disabledCapabilities": ["documentSymbolProvider"]
		},
		"venv-probe": {
			"command": ["glsp-venv-probe"],
			"filePatterns": ["*.probe"],
			"rootMarkers": ["pyproject.toml"],
			"venv": true
		},
		"fake": {
			"command": ["glsp-fake-server"],
			"filePatterns": ["*.fake"],
			"rootMarkers": ["fake.root"],
			"multiRoot": false
		},
		"fake-slow": {
			"command": ["glsp-fake-server"],
			"languages": ["ini"],
			"rootMarkers": ["fake.root"],
			"env": { "FAKE_INIT_DELAY": "4000" }
		},
		"fake-race": {
			"command": ["glsp-fake-server"],
			"languages": ["properties"],
			"rootMarkers": ["fake.root"],
			"env": { "FAKE_INIT_DELAY": "2500" },
			"settings": { "v": 1 }
		},
		"fake-idle": {
			"command": ["glsp-fake-server"],
			"languages": ["bat"],
			"rootMarkers": ["fake.root"]
		},
		"fake-crash": {
			"command": ["glsp-fake-server"],
			"filePatterns": ["*.crash"],
			"rootMarkers": ["fake.root"],
			"env": { "FAKE_CRASH_AFTER": "300" }
		}
	},
	"generalLsp.formatters": {
		"upper": {
			"command": ["glsp-upper"],
			"filePatterns": ["*.up", "fmtme.c", "prefer.go"]
		},
		"not-installed": {
			"command": ["glsp-no-such-formatter"],
			"filePatterns": ["*.up"]
		},
		"suffix": {
			"command": ["sed", "s/$/;/"],
			"filePatterns": ["*.up"]
		},
		"in-place": {
			"command": [
				"sh",
				"-c",
				"printf 'rewritten %s\\n' \"$(basename \"$0\" | cut -c1-12)\" > \"$0\"; exit 3",
				"${file}"
			],
			"filePatterns": ["*.inplace"],
			"stdin": false,
			"exitCodes": [0, 3]
		},
		"broken": {
			"command": ["sh", "-c", "exit 2"],
			"filePatterns": ["*.broken"]
		},
		"relative": {
			"command": ["./upper.sh"],
			"filePatterns": ["*.relfmt"],
			"rootMarkers": ["fake.root"]
		},
		"slowfmt": {
			"command": ["sleep", "5"],
			"filePatterns": ["*.slowfmt"],
			"timeout": 300
		}
	}
}
